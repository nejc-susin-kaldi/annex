# Static config, ANNEX_TLS_MODE=local: HTTPS on 443 with the mkcert wildcard cert.
global:
  checkNewVersion: false
  sendAnonymousUsage: false
log:
  level: INFO
accessLog:
  format: json
  fields:
    headers:
      defaultMode: drop
      names:
        Remote-User: keep
        X-Request-Id: keep   # the app's response header (and the client's request header), so one id links log lines
ping:
  entryPoint: ping
entryPoints:
  ping:
    address: ":8082"
  web:
    address: ":80"
    http:
      # drop Remote_User / Remote.User aliases that WSGI-style backends read as Remote-User
      aliasHeadersStrategy: delete
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: false
  websecure:
    address: ":443"
    asDefault: true
    http:
      aliasHeadersStrategy: delete
      tls: {}
      # every router: drop client-sent identity headers, then forward-auth
      middlewares:
        - strip-identity@file
        - authelia@file
  # Headscale and the webhook receiver for the internet (ANNEX_ACCESS=headscale, D120): published only by
  # compose.access-headscale.yaml, and only routers that name it are on it. No forward-auth: Tailscale clients carry
  # their own keys, and webhooks bypass the sign-in anyway
  public:
    address: ":8443"
    http:
      aliasHeadersStrategy: delete
      tls: {}
providers:
  docker:
    endpoint: tcp://socket-ro:2375
    exposedByDefault: false
    # the default for platform routes (gateway, hooks). Each app's container says
    # traefik.docker.network: annex-app-<name>, its own network, which Traefik joins at deploy (D88)
    network: annex-edge
    constraints: Label(`com.kaldi.annex`, `true`)
  file:
    directory: /etc/traefik/dynamic
    watch: true
