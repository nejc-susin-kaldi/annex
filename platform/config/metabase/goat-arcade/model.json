{
  "_comment": "Goat Arcade's Metabase connection (GA.3, D109): the database Metabase calls 'Goat Arcade' (product-db, schema annex_api, read-only as metabase_ro), the views setup waits for after a sync, and the column types and names it sets. vm/metabase_content.py applies it on every run, changing only what differs. Rules: 'keys' makes a column the entity key of its home view and a foreign key to it wherever else a column of that name (or an alias in 'key_aliases') appears; 'currency_suffix' columns become EUR currency; 'coordinates' set latitude and longitude; 'tables' and 'fields' set display names ('fields' by column name, in every view that has the column).",
  "database": "Goat Arcade",
  "schema": "annex_api",
  "views": ["venues", "machine_models", "machine_floor", "leaderboard", "player_profiles", "daily_plays",
            "hourly_plays", "machine_events_daily", "service_log", "revenue_weekly", "tournaments",
            "tournament_entries", "tournament_standings"],
  "keys": {
    "venue_code": "venues",
    "machine_id": "machine_floor",
    "model_id": "machine_models",
    "nickname": "player_profiles",
    "tournament_id": "tournaments",
    "ticket_id": "service_log"
  },
  "key_aliases": {
    "home_venue_code": "venue_code",
    "current_venue_code": "venue_code",
    "winner_nickname": "nickname"
  },
  "currency_suffix": "_eur",
  "currency": "EUR",
  "coordinates": {"lat": "type/Latitude", "lon": "type/Longitude"},
  "tables": {
    "daily_plays": "Plays per Day",
    "hourly_plays": "Plays per Hour",
    "machine_events_daily": "Machine Events per Day",
    "revenue_weekly": "Cash Counted per Week",
    "machine_floor": "Machine Floor",
    "service_log": "Service Tickets",
    "tournament_entries": "Tournament Entries",
    "tournament_standings": "Tournament Standings",
    "player_profiles": "Members"
  },
  "fields": {
    "lat": "Latitude",
    "lon": "Longitude",
    "venue_code": "Venue",
    "home_venue_code": "Home Venue",
    "current_venue_code": "Current Venue",
    "machine_id": "Machine ID",
    "model_id": "Model ID",
    "ticket_id": "Ticket ID",
    "tournament_id": "Tournament ID",
    "revenue_eur": "Estimated Revenue",
    "amount_eur": "Cash Counted",
    "coins_eur": "Coins",
    "parts_cost_eur": "Parts Cost",
    "price_per_play_eur": "Price per Play",
    "entry_fee_eur": "Entry Fee",
    "avg_duration_s": "Average Game (seconds)",
    "games_7d": "Games, Last 7 Days",
    "games_30d": "Games, Last 30 Days",
    "games_180d": "Games, Last 180 Days",
    "downtime_hours": "Downtime (hours)",
    "labour_hours": "Labour (hours)",
    "took_machine_off_floor": "Took Machine off the Floor",
    "out_of_order": "Out of Order",
    "open_ticket": "Open Ticket",
    "card_plays": "Member-Card Plays",
    "serial_no": "Serial No.",
    "max_multiball": "Max Multiball",
    "era_name": "Era (spelled out)",
    "manufacturer_country": "Manufacturer Country",
    "cabinets_on_floor": "Cabinets on the Floor",
    "leaderboard_spots": "Leaderboard Spots",
    "winner_nickname": "Winner",
    "winner_handle": "Winner's Initials",
    "max_players": "Places"
  }
}
