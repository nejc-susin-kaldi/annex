# Platform services and add-on placeholders. Deployed apps appear through Docker labels written by the deploy, in
# their team's group (config/teams.json: Venues, Technical, Finance, Community) or "Tools" (D107).
- Platform:
    - Metabase:
        href: "{{ANNEX_URL_METABASE}}"
        description: Analytics on Goat Arcade's curated data
        icon: metabase.png
        server: annex
        container: annex-metabase-1
    - Logs:
        href: "{{ANNEX_URL_LOGS}}"
        description: Container logs (admins only)
        icon: dozzle.png
        server: annex
        container: annex-dozzle-1
    - Data gateway:
        href: "{{ANNEX_URL_GATEWAY}}"
        description: Read-only API over Goat Arcade's curated views (admins only)
        icon: mdi-api
        server: annex
        container: annex-gateway-1
    - Console:
        href: "{{ANNEX_URL_CONSOLE}}"
        description: "Your apps at a glance (builders see their own, admins all): status, releases, usage, errors, logs and config. Read-only"
        icon: mdi-view-dashboard-outline
        server: annex
        container: annex-console-1
    - Status:
        href: "{{ANNEX_URL_CONSOLE}}/status"
        description: Health of every app and the platform
        icon: mdi-heart-pulse
        widget:
          type: customapi
          url: http://ops:8000/tiles/_status
          refreshInterval: 30000
          mappings:
            - field: up
              label: Up
            - field: down
              label: Down
              color: adaptive
    - Mail:
        href: "{{ANNEX_URL_MAIL}}"
        description: "Outgoing email (prototype catcher: nothing leaves the server). Admins only"
        icon: mailpit.png
        server: annex
        container: annex-mailpit-1
- Add-ons:
    - Goat Mailer:
        href: "{{ANNEX_URL_HOME}}/#goat-mailer"
        description: Email templating (optional add-on, not installed)
        icon: mdi-email-edit-outline
    - Bekafon:
        href: "{{ANNEX_URL_HOME}}/#bekafon"
        description: AI website helper with voice chat (optional add-on, not installed)
        icon: mdi-account-voice
