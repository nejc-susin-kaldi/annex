# Authelia, file backend with demo users. Users and secrets live in
# /srv/annex/secrets/authelia on the VM, generated by vm/bootstrap-secrets.sh.
theme: auto
server:
  address: tcp://:9091/
log:
  level: info
ntp:
  disable_startup_check: true
totp:
  issuer: Annex
authentication_backend:
  password_reset:
    disable: true
  password_change:
    disable: true
  file:
    path: /secrets/users.yml
    watch: true
    password:
      algorithm: argon2
access_control:
  default_policy: deny
  rules:
    - domain: "{{ANNEX_HOST_AUTH}}"
      policy: bypass
    - domain: ["{{ANNEX_HOST_LOGS}}", "{{ANNEX_HOST_GATEWAY}}", "{{ANNEX_HOST_MAIL}}"]
      policy: one_factor
      subject: ["group:admins"]
    - domain: ["{{ANNEX_HOST_LOGS}}", "{{ANNEX_HOST_GATEWAY}}", "{{ANNEX_HOST_MAIL}}"]
      policy: deny
    - domain_regex: '{{ANNEX_HOST_REGEX}}'
      policy: one_factor
session:
  name: annex_session
  inactivity: 8h
  expiration: 12h
  cookies:
    - domain: "{{ANNEX_COOKIE_DOMAIN}}"
      authelia_url: "{{ANNEX_URL_AUTH}}"
      default_redirection_url: "{{ANNEX_URL_HOME}}"
regulation:
  max_retries: 5
  find_time: 2m
  ban_time: 5m
storage:
  local:
    path: /data/db.sqlite3
notifier:
  filesystem:
    filename: /data/notification.txt
