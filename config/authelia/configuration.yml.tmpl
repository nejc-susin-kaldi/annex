# Authelia, file backend with demo users. Users and secrets live in
# /srv/annex/secrets/authelia on the VM, generated by vm/bootstrap-secrets.sh.
theme: auto
server:
  address: tcp://:9091/
  endpoints:
    rate_limits:
      # `annex users add/reset` sends every invitation from the VM's own address, so the default (5 per 10 min
      # per address) would stop an admin inviting a team; still limited, against email bombing (D57)
      reset_password_start:
        enable: true
        buckets:
          - period: 10m
            requests: 30
          - period: 1h
            requests: 100
log:
  level: info
ntp:
  disable_startup_check: true
totp:
  issuer: Annex
identity_validation:
  reset_password:
    # `annex users add` invites a user with the reset link, so it lives longer than Authelia's 5-minute default
    jwt_lifespan: 24h
authentication_backend:
  # Annex's own accounts (no company SSO needed): users reset a forgotten password by email and change it
  # themselves; admins manage accounts with `annex users` (D57)
  password_reset:
    disable: false
  password_change:
    disable: false
  file:
    path: /secrets/users.yml
    watch: true
    password:
      algorithm: argon2
access_control:
  default_policy: deny
  rules:
    # incoming webhooks (M1.5): no login; annex-ops checks the provider's signature instead
    - domain: "{{ANNEX_HOST_HOOKS}}"
      policy: bypass
    - domain: "{{ANNEX_HOST_AUTH}}"
      policy: bypass
    - domain: ["{{ANNEX_HOST_LOGS}}", "{{ANNEX_HOST_GATEWAY}}", "{{ANNEX_HOST_MAIL}}"]
      policy: one_factor
      subject: ["group:admins"]
    - domain: ["{{ANNEX_HOST_LOGS}}", "{{ANNEX_HOST_GATEWAY}}", "{{ANNEX_HOST_MAIL}}"]
      policy: deny
    - domain_regex: '{{ANNEX_HOST_REGEX}}'
      policy: one_factor
session:
  name: annex_session
  inactivity: 8h
  expiration: 12h
  cookies:
    - domain: "{{ANNEX_COOKIE_DOMAIN}}"
      authelia_url: "{{ANNEX_URL_AUTH}}"
      default_redirection_url: "{{ANNEX_URL_HOME}}"
regulation:
  max_retries: 5
  find_time: 2m
  ban_time: 5m
storage:
  local:
    path: /data/db.sqlite3
password_policy:
  standard:
    enabled: true
    min_length: 12
    max_length: 0
notifier:
  # reset and invitation emails go out like every other platform email: to Mailpit in the prototype
  smtp:
    address: "smtp://mailpit:1025"
    sender: "Annex <{{ANNEX_EMAIL_FROM}}>"
    subject: "[Annex] {title}"
    disable_require_tls: true
