# The local stack (D99): the platform on this machine's Docker (Docker Desktop on the Mac), for development and tests.
# Copy to .env.local (gitignored) to change anything; without it the scripts read this file.
# Selected per command with ANNEX_ENV=local, never by default:
#   ANNEX_ENV=local scripts/bootstrap.sh && ANNEX_ENV=local scripts/push.sh && ANNEX_ENV=local scripts/test-smoke.sh
# Same keys as .env.example, plus ANNEX_TARGET, ANNEX_DOCKER_CONTEXT and ANNEX_BIND_*.

# local: scripts and the CLI run commands on this machine (bash -c) instead of `ssh $ANNEX_SSH_HOST`
ANNEX_TARGET=local
# The Docker context the local stack uses; scripts and the CLI export DOCKER_CONTEXT for their own commands only and
# never switch your current context. Must point at a local daemon (unix socket); a context that points at the VM is
# refused. Empty: Docker's own default (DOCKER_HOST, else the current context), e.g. on a Linux CI runner.
ANNEX_DOCKER_CONTEXT=desktop-linux
# Unused locally (messages only)
ANNEX_SSH_HOST=annex
# Root of all local Annex state. Outside the repo (rsync and git must never see it) and under your home folder
# (Docker Desktop shares it with containers). Wipe: docs/setup.md "Local stack".
ANNEX_DATA_DIR=$HOME/.annex/local

# Hostnames of their own, so a browser can hold a session on the VM's stack and this one at once (cookies ignore
# ports). Browser access needs /etc/hosts lines (docs/setup.md "Local stack"); the suites don't (curl --connect-to).
ANNEX_HOST_PATTERN={name}.annex-local.home.arpa
ANNEX_COOKIE_DOMAIN=
ANNEX_TLS_MODE=local
ANNEX_UPSTREAM_IP=

# Traefik on loopback only. 9443/9080, not 443/80 (taken on the Mac) or 8443 (scripts/tunnel.sh's port for the VM),
# so both stacks can run at once. ANNEX_PUBLIC_PORT must be the port of ANNEX_BIND_HTTPS.
ANNEX_PUBLIC_PORT=9443
ANNEX_BIND_HTTPS=127.0.0.1:9443
ANNEX_BIND_HTTP=127.0.0.1:9080

ANNEX_EMAIL_DOMAINS=annex.example,goat-arcade.example
ANNEX_EMAIL_ALLOW=
ANNEX_EMAIL_FROM=noreply@annex.example
ANNEX_ALERT_SLACK_CHANNEL=#annex-alerts
ANNEX_APP_SUBNETS=10.213.0.0/16
ANNEX_BUILD_MIN_FREE_GB=
ANNEX_IMAGE_MAX_MB=
TZ=Europe/Ljubljana
