# Copy to .env (gitignored) and adjust. Read by scripts/render.py, bootstrap.sh and push.sh.
# This is the VM's settings file (ANNEX_ENV unset or vm); the local stack's is .env.local (.env.local.example, D99).
# Another instance (D118) copies this file to .env.<name> and is run with ANNEX_ENV=<name>, e.g. .env.kaldi.
# Quote a value with spaces (ANNEX_ADMIN_NAME="Ana Novak"): the scripts source this file with bash.

# SSH alias for the VM (see ~/.ssh/config)
ANNEX_SSH_HOST=annex
# Root of all Annex state on the VM
ANNEX_DATA_DIR=/srv/annex

# How hostnames are built. Must contain {name} as the first label or part of it.
#   nested: {name}.annex.home.arpa      flat: annex-{name}.example.com
ANNEX_HOST_PATTERN={name}.annex.home.arpa
# Authelia cookie domain. Leave empty to derive it from the pattern
# (everything after the label that holds {name}).
ANNEX_COOKIE_DOMAIN=

# local:    the VM's Traefik terminates HTTPS on 443 with a mkcert wildcard certificate
# upstream: an upstream proxy terminates HTTPS; Traefik serves plain HTTP on 80
# acme:     Traefik gets a Let's Encrypt wildcard certificate itself, by DNS-01 in Route53, with the EC2 instance's
#           IAM role (D118; docs/new-instance.md, "On EC2")
ANNEX_TLS_MODE=local
# upstream mode only: the upstream proxy's LAN IP (dronky); X-Forwarded-* is trusted only from it
ANNEX_UPSTREAM_IP=
# acme mode only: the address Let's Encrypt writes to about the certificate; true = its staging CA (untrusted
# certificates, no rate limits: for a first try)
ANNEX_ACME_EMAIL=
ANNEX_ACME_STAGING=

# The demo client (D118). on: Goat Arcade's database and the three demo users (sam, maja, kaldi-admin) come with the
# platform, and the test suites run. off: an instance for real use; bootstrap makes one admin account from
# ANNEX_ADMIN_* instead, and tests/instance.sh checks it read-only.
ANNEX_DEMO=on
ANNEX_ADMIN_LOGIN=
ANNEX_ADMIN_NAME=
ANNEX_ADMIN_EMAIL=
# Sign-in (D118): one = a password; two = a password and a second factor (TOTP app or passkey) on every app and
# admin page. Two needs ANNEX_MAIL_RELAY=on: registering the second factor sends a code by email.
ANNEX_AUTH_FACTORS=one

# Employee access (D120): open = whoever the network in front lets through reaches the sign-in page; headscale = the
# apps are for Annex's own tailnet (Headscale), and only Headscale and the webhook receiver answer from the internet,
# on ANNEX_BIND_PUBLIC (default 8443). An instance setting: docs/new-instance.md 8.7. Needs ANNEX_TLS_MODE acme (or local).
ANNEX_ACCESS=open
ANNEX_BIND_PUBLIC=
# Optional sign-in to the tailnet with the client's identity provider (OIDC), besides one-time keys: the issuer URL,
# the client id and the email domains allowed (space-separated, required). The secret goes in
# secrets/headscale/oidc_client_secret on the server.
ANNEX_ACCESS_OIDC_ISSUER=
ANNEX_ACCESS_OIDC_CLIENT_ID=
ANNEX_ACCESS_OIDC_DOMAINS=

# Optional port appended to every public URL, e.g. 8443 when testing through
# `ssh -L 8443:localhost:443 annex`. Leave empty when served on 443.
ANNEX_PUBLIC_PORT=
# Where Traefik publishes on the VM ([address:]port). Empty = 80 and 443 on every interface.
# (The local stack, .env.local.example, binds loopback ports instead: D99.)
ANNEX_BIND_HTTP=
ANNEX_BIND_HTTPS=

# Email (annex-ops): who apps may send to. Mail goes to Mailpit in the prototype, so nothing leaves the VM.
# ANNEX_MAIL_RELAY=on (D118): Mailpit also relays every message to the SMTP server in secrets/mailpit/relay.yaml on the
# VM, which a human writes (docs/new-instance.md, "Mail"); ANNEX_EMAIL_FROM must then be a sender that server accepts.
ANNEX_MAIL_RELAY=off
# Company domains, comma-separated. Anyone else is rejected.
ANNEX_EMAIL_DOMAINS=annex.example,goat-arcade.example
# Extra exact addresses outside those domains (in production the client approves each), comma-separated
ANNEX_EMAIL_ALLOW=
ANNEX_EMAIL_FROM=noreply@annex.example

# Where annex-ops posts platform and app alerts when Slack is connected (invite the Slack app there)
ANNEX_ALERT_SLACK_CHANNEL=#annex-alerts

# Per-app networks (D88): every app network and egress network gets the lowest free /24 of this range. Must not
# overlap the LAN or Docker's own pools (172.17-31.x, 192.168.x); 10.213.0.0/16 gives 256 networks.
ANNEX_APP_SUBNETS=10.213.0.0/16

# Build limits (D95), read by the CLI at deploy: a build is refused with less than this free on the data disk, and an
# image above this size is refused and removed. Empty = 3 and 2048.
ANNEX_BUILD_MIN_FREE_GB=
ANNEX_IMAGE_MAX_MB=

TZ=Europe/Ljubljana
