# Copy to .env (gitignored) and adjust. Read by scripts/render.py, bootstrap.sh and push.sh.
# This is the VM's settings file (ANNEX_ENV unset or vm); the local stack's is .env.local (.env.local.example, D99).

# SSH alias for the VM (see ~/.ssh/config)
ANNEX_SSH_HOST=annex
# Root of all Annex state on the VM
ANNEX_DATA_DIR=/srv/annex

# How hostnames are built. Must contain {name} as the first label or part of it.
#   nested: {name}.annex.home.arpa      flat: annex-{name}.example.com
ANNEX_HOST_PATTERN={name}.annex.home.arpa
# Authelia cookie domain. Leave empty to derive it from the pattern
# (everything after the label that holds {name}).
ANNEX_COOKIE_DOMAIN=

# local:    the VM's Traefik terminates HTTPS on 443 with a mkcert wildcard certificate
# upstream: an upstream proxy terminates HTTPS; Traefik serves plain HTTP on 80
ANNEX_TLS_MODE=local
# upstream mode only: the upstream proxy's LAN IP (dronky); X-Forwarded-* is trusted only from it
ANNEX_UPSTREAM_IP=

# Optional port appended to every public URL, e.g. 8443 when testing through
# `ssh -L 8443:localhost:443 annex`. Leave empty when served on 443.
ANNEX_PUBLIC_PORT=
# Where Traefik publishes on the VM ([address:]port). Empty = 80 and 443 on every interface.
# (The local stack, .env.local.example, binds loopback ports instead: D99.)
ANNEX_BIND_HTTP=
ANNEX_BIND_HTTPS=

# Email (annex-ops): who apps may send to. Mail goes to Mailpit in the prototype, so nothing leaves the VM.
# Company domains, comma-separated. Anyone else is rejected.
ANNEX_EMAIL_DOMAINS=annex.example
# Extra exact addresses outside those domains (in production the client approves each), comma-separated
ANNEX_EMAIL_ALLOW=
ANNEX_EMAIL_FROM=noreply@annex.example

# Where annex-ops posts platform and app alerts when Slack is connected (invite the Slack app there)
ANNEX_ALERT_SLACK_CHANNEL=#annex-alerts

# Per-app networks (D88): every app network and egress network gets the lowest free /24 of this range. Must not
# overlap the LAN or Docker's own pools (172.17-31.x, 192.168.x); 10.213.0.0/16 gives 256 networks.
ANNEX_APP_SUBNETS=10.213.0.0/16

# Build limits (D95), read by the CLI at deploy: a build is refused with less than this free on the data disk, and an
# image above this size is refused and removed. Empty = 3 and 2048.
ANNEX_BUILD_MIN_FREE_GB=
ANNEX_IMAGE_MAX_MB=

TZ=Europe/Ljubljana
