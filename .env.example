# Copy to .env (gitignored) and adjust. Read by scripts/render.py, bootstrap.sh and push.sh.

# SSH alias for the VM (see ~/.ssh/config)
ANNEX_SSH_HOST=annex
# Root of all Annex state on the VM
ANNEX_DATA_DIR=/srv/annex

# How hostnames are built. Must contain {name} as the first label or part of it.
#   nested: {name}.annex.home.arpa      flat: annex-{name}.example.com
ANNEX_HOST_PATTERN={name}.annex.home.arpa
# Authelia cookie domain. Leave empty to derive it from the pattern
# (everything after the label that holds {name}).
ANNEX_COOKIE_DOMAIN=

# local:    the VM's Traefik terminates HTTPS on 443 with a mkcert wildcard certificate
# upstream: an upstream proxy terminates HTTPS; Traefik serves plain HTTP on 80
ANNEX_TLS_MODE=local
# upstream mode only: the upstream proxy's LAN IP (dronky); X-Forwarded-* is trusted only from it
ANNEX_UPSTREAM_IP=

# Optional port appended to every public URL, e.g. 8443 when testing through
# `ssh -L 8443:localhost:443 annex`. Leave empty when served on 443.
ANNEX_PUBLIC_PORT=

TZ=Europe/Ljubljana
